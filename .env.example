# LightRAG server settings (read by `lightrag-server` from this directory)

# Server: localhost only, since no login is configured
HOST=127.0.0.1
PORT=9621
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs

# LLM: Ollama Cloud model, routed through the local Ollama daemon
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_MODEL=glm-5.3-flash:cloud
OLLAMA_LLM_THINK=false

# Embeddings: local nomic-embed-text (768 dims) with its task prefixes
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_ASYMMETRIC=true
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "

# Extraction tuned for the GFM desk data (prompts/entity_type/gfm_desk.yml)
ENTITY_TYPE_PROMPT_FILE=gfm_desk.yml
# Parallel LLM calls to Ollama Cloud (default 4)
MAX_ASYNC=8
# Local CPU embeddings: fewer concurrent calls and a longer timeout, so
# requests queued behind each other don't hit the 30s default (phase 1 halted on it)
EMBEDDING_TIMEOUT=180
EMBEDDING_FUNC_MAX_ASYNC=2
